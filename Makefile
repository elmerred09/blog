GO ?= $(shell command -v go || echo /usr/local/go/bin/go)
GOROOT := $(shell $(GO) env GOROOT)
GOPATH := $(shell $(GO) env GOPATH)

# Node comes from nvm, at the major version in web/.nvmrc. nvm only loads in
# interactive shells, so make (and the git and Cursor hooks that call it) put
# the newest installed matching version first on PATH. Prepended, not appended,
# so it wins over any Windows npm that WSL adds to PATH.
NODE_MAJOR := $(shell cat web/.nvmrc 2>/dev/null)
NVM_DIR ?= $(HOME)/.nvm
NODE_BIN := $(shell ls -d $(NVM_DIR)/versions/node/v$(NODE_MAJOR).*/bin 2>/dev/null | sort -V | tail -n 1)

export PATH := $(if $(NODE_BIN),$(NODE_BIN):)$(PATH):$(GOROOT)/bin:$(GOPATH)/bin

SQLC := $(GO) tool sqlc
LEFTHOOK := $(GO) tool lefthook
GOOSE := $(GO) tool goose

GOOSE_DRIVER := postgres
GOOSE_MIGRATION_DIR := db/migrations
GOOSE_DBSTRING ?= postgres://blog:blog@localhost:5432/blog?sslmode=disable
# goose gets its settings only from the environment. Make exports a
# GOOSE_DBSTRING given on its command line, and goose inserts an exported one
# into its arguments, so also passing the DSN as an argument would duplicate it.
GOOSE_RUN = GOOSE_DRIVER=$(GOOSE_DRIVER) GOOSE_DBSTRING='$(GOOSE_DBSTRING)' GOOSE_MIGRATION_DIR=$(GOOSE_MIGRATION_DIR) $(GOOSE)

# The Playwright suite's own database in the compose Postgres; make e2e-db
# recreates it on every run.
E2E_DB := blog_e2e
E2E_DBSTRING := postgres://blog:blog@localhost:5432/$(E2E_DB)?sslmode=disable
# Extra arguments for playwright test, e.g. E2E_ARGS="admin-editor --headed".
E2E_ARGS ?=
# Extra flags for playwright install, e.g. --with-deps on a distro missing Chromium's libraries.
E2E_INSTALL_FLAGS ?=

# Seed file for `make seed`: a name in db/seed without the .sql suffix, e.g. SEED=posts-tags.
SEED_DIR := db/seed
SEED ?= posts-tags

# Files for fmt targets; override with FILES="a.go b.go".
# Note: FILES is expanded unquoted, so paths containing spaces are unsupported.
FILES ?= .

WEB := web
PRETTIER := ./node_modules/.bin/prettier
# Code highlighting stylesheet for rendered posts, generated by blogctl css.
CHROMA_CSS := $(WEB)/app/chroma.css
# Go API base URL for `make web`; matches the API's default HTTP_ADDR.
API_URL ?= http://localhost:8080
# Baked into prerendered metadata. Production sets the real domain at build
# time; SITE_INDEXING=true is the only value that lets robots.txt allow crawling.
SITE_URL ?= http://localhost:3000
# Files for web-fmt, relative to web/ or absolute; override with WEB_FILES="app/page.tsx".
WEB_FILES ?= .

.PHONY: sqlc sqlc-check lint fmt fmt-check test deps-check hooks migrate migrate-down migrate-status migrate-new up down restart otel-up otel-down seed e2e-db e2e-install e2e e2e-ui api admin-keys node-check \
	web-install web-deps web web-build web-lint web-typecheck web-fmt web-fmt-check web-test web-types web-types-check web-check \
	chroma-css chroma-css-check

up:
	docker compose up -d

down:
	docker compose down

restart:
	docker compose down
	docker compose up -d

# Local traces and logs (Grafana on http://localhost:3001). A separate profile,
# so `make up` stays the database and the bucket.
otel-up:
	docker compose --profile observability up -d otel-lgtm

otel-down:
	docker compose --profile observability rm -f -s otel-lgtm

migrate:
	$(GOOSE_RUN) up

migrate-down:
	$(GOOSE_RUN) down

migrate-status:
	$(GOOSE_RUN) status

migrate-new:
	$(GOOSE_RUN) create $(NAME) sql

seed:
	@if [ -z "$(SEED)" ] || [ ! -f "$(SEED_DIR)/$(SEED).sql" ]; then \
		echo "usage: make seed SEED=<name>"; \
		echo "available seeds:"; \
		ls $(SEED_DIR) | sed -n 's/\.sql$$//p' | sed 's/^/  /'; \
		exit 1; \
	fi
	docker compose exec -T postgres psql "$(GOOSE_DBSTRING)" -v ON_ERROR_STOP=1 < $(SEED_DIR)/$(SEED).sql

# Drops and recreates the E2E database, with the extensions db/init gives the
# dev one, then migrates it. Runs before Playwright starts the API, so nothing
# holds a connection; FORCE still ends any left by an earlier run.
e2e-db: GOOSE_DBSTRING = $(E2E_DBSTRING)
e2e-db:
	docker compose exec -T postgres psql -U blog -d postgres -v ON_ERROR_STOP=1 -q \
		-c 'DROP DATABASE IF EXISTS $(E2E_DB) WITH (FORCE)' -c 'CREATE DATABASE $(E2E_DB)'
	docker compose exec -T postgres psql -U blog -d $(E2E_DB) -v ON_ERROR_STOP=1 -q < db/init/01-extensions.sql
	$(GOOSE_RUN) up

# Playwright's Chromium. On a distro Playwright doesn't support, such as
# Ubuntu 20.04, set PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu22.04-x64.
e2e-install: web-deps
	cd $(WEB) && ./node_modules/.bin/playwright install $(E2E_INSTALL_FLAGS) chromium

# The end-to-end suite against a fresh blog_e2e, with fresh keys. Playwright
# starts the API on :8081 and a production Next build on :3100 itself, so a
# dev stack can keep running. Needs make up and make e2e-install first.
e2e: web-deps e2e-db
	scripts/e2e-env.sh '$(E2E_DBSTRING)'
	cd $(WEB) && ./node_modules/.bin/playwright test $(E2E_ARGS)

# The same, in Playwright's UI mode.
e2e-ui: web-deps e2e-db
	scripts/e2e-env.sh '$(E2E_DBSTRING)'
	cd $(WEB) && ./node_modules/.bin/playwright test --ui $(E2E_ARGS)

# OTEL=1 exports traces and logs to make otel-up. Unset, the API exports nothing.
api:
	@set -a; [ -f .env ] && . ./.env; set +a; \
		DATABASE_URL="$(GOOSE_DBSTRING)" \
		$(if $(filter 1,$(OTEL)),OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 OTEL_SERVICE_NAME=blog-api,) \
		$(GO) run ./cmd/api

# Writes the gitignored .env and web/.env.local; see scripts/admin-keys.sh.
admin-keys:
	@scripts/admin-keys.sh "$(ADMIN_GITHUB_ID)"

# Written to a temp file first, so a failed run doesn't leave a truncated stylesheet.
chroma-css:
	$(GO) run ./cmd/blogctl css > $(CHROMA_CSS).tmp || { rm -f $(CHROMA_CSS).tmp; exit 1; }
	mv $(CHROMA_CSS).tmp $(CHROMA_CSS)

chroma-css-check:
	@$(GO) run ./cmd/blogctl css | diff -u $(CHROMA_CSS) - || { echo "$(CHROMA_CSS) is out of date; run: make chroma-css"; exit 1; }

sqlc:
	@if [ -f sqlc.yaml ]; then $(SQLC) generate; else echo "sqlc.yaml not found, skipping sqlc generate"; fi

sqlc-check:
	@if [ -f sqlc.yaml ]; then $(SQLC) diff; else echo "sqlc.yaml not found, skipping sqlc diff"; fi

lint:
	golangci-lint run ./...

fmt:
	gofmt -w $(FILES)

fmt-check:
	@out=$$(gofmt -l $(FILES)); \
	if [ -n "$$out" ]; then \
		echo "These files need gofmt (run: make fmt FILES=<file>):"; \
		echo "$$out"; \
		exit 1; \
	fi

test:
	$(GO) test -race ./...

# Fails if go.mod/go.sum are not tidy or downloaded modules don't match go.sum.
deps-check:
	$(GO) mod tidy -diff
	$(GO) mod verify

# Fail unless node and npm resolve to the nvm install of the major in web/.nvmrc.
node-check:
	@if [ -z "$(NODE_BIN)" ]; then \
		echo "no Node $(NODE_MAJOR).x under $(NVM_DIR); run: nvm install $(NODE_MAJOR)"; exit 1; \
	fi
	@if [ "$$(command -v node)" != "$(NODE_BIN)/node" ] || [ "$$(command -v npm)" != "$(NODE_BIN)/npm" ]; then \
		echo "node/npm resolve to $$(command -v node) and $$(command -v npm), want $(NODE_BIN)"; exit 1; \
	fi
	@echo "node $$(node --version), npm $$(npm --version) from $(NODE_BIN)"

web-install:
	cd $(WEB) && npm ci

# Fails instead of installing: lefthook runs several web targets in parallel,
# and concurrent npm ci runs would clobber each other's node_modules.
web-deps:
	@if [ ! -f $(WEB)/node_modules/.package-lock.json ] || [ $(WEB)/package-lock.json -nt $(WEB)/node_modules/.package-lock.json ]; then \
		echo "web/node_modules is missing or older than package-lock.json; run: make web-install"; exit 1; \
	fi

# Next loads web/.env.local itself. Don't source it here: exported variables
# win over the file, and the shell would keep each \n in the key literal.
# OTEL=1 exports traces to make otel-up. Unset, Next exports nothing.
# NEXT_OTEL_VERBOSE=1 adds the spans Next hides by default.
web: web-deps
	cd $(WEB) && API_URL="$(API_URL)" SITE_URL="$(SITE_URL)" \
		$(if $(filter 1,$(OTEL)),OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 OTEL_SERVICE_NAME=blog-web,) \
		npm run dev

web-build: web-deps
	cd $(WEB) && SITE_URL="$(SITE_URL)" npm run build

web-lint: web-deps
	cd $(WEB) && npm run --silent lint

web-typecheck: web-deps
	cd $(WEB) && npm run --silent typecheck

web-fmt: web-deps
	cd $(WEB) && $(PRETTIER) --write --ignore-unknown --log-level warn $(WEB_FILES)

web-fmt-check: web-deps
	cd $(WEB) && npm run --silent format:check

web-test: web-deps
	cd $(WEB) && npm run --silent test

# TypeScript types for the HTTP API, generated from api/openapi.yaml.
web-types: web-deps
	cd $(WEB) && npm run --silent types

web-types-check: web-deps
	cd $(WEB) && npm run --silent types:check

# Everything the commit and push hooks run for web/, in one target (for CI).
web-check: web-lint web-typecheck web-fmt-check web-types-check web-test

# Install the git hooks defined in lefthook.yml (once per clone).
hooks:
	$(LEFTHOOK) install
