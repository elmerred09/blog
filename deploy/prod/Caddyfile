# Cloudflare talks to the origin over HTTPS (Full strict) with the origin
# certificate in /certs. auto_https is off so Caddy does not start an ACME
# challenge behind the proxy. DOMAIN comes from caddy.env.
#
# The ranges are Cloudflare's published proxies. The client IP is then the
# visitor in CF-Connecting-IP. A direct connection is not trusted, so a
# spoofed header keeps the socket address.
{
	auto_https off
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN}:443 {
	tls /certs/origin.pem /certs/origin.key
	encode gzip zstd
	log {
		output stdout
	}
	reverse_proxy web:3000
}

{$DOMAIN}:80 {
	redir https://{$DOMAIN}{uri} permanent
}

www.{$DOMAIN}:443 {
	tls /certs/origin.pem /certs/origin.key
	redir https://{$DOMAIN}{uri} permanent
}

www.{$DOMAIN}:80 {
	redir https://{$DOMAIN}{uri} permanent
}
