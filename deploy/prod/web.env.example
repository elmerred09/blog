# Next.js process environment. Copy to /srv/blog/web.env and fill in. Mode 600.
# Leave every OTEL_* variable unset. Telemetry stays off without them.
# SITE_URL and SITE_INDEXING are also build args. The running container reads
# them again for requests that are not frozen at build time. Keep the two copies
# the same. The image is built with SITE_INDEXING=false until indexing is turned on.

# http://api:8080
API_URL=

# https://<domain>
SITE_URL=

# false, or true after a rebuild that should allow crawling.
SITE_INDEXING=

# https://<domain>
BETTER_AUTH_URL=

# Hex string. Seals the admin session cookie.
BETTER_AUTH_SECRET=

# From the production GitHub OAuth app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Numeric GitHub user id. Comma-separated if there is more than one.
ADMIN_GITHUB_IDS=

# Ed25519 private key, one line, with \n standing in for newlines.
ADMIN_JWT_PRIVATE_KEY=
