# API process environment. Copy to /srv/blog/api.env and fill in. Mode 600.
# Leave every OTEL_* variable unset. Telemetry stays off without them.

# postgres://blog:<password>@postgres:5432/blog?sslmode=disable
# The host name postgres is the Compose service. The password matches postgres.env.
DATABASE_URL=

# Ed25519 public key, one line, with \n standing in for newlines.
ADMIN_JWT_PUBLIC_KEY=

# Comma-separated. Each entry is github:<numeric GitHub user id>.
ADMIN_SUBJECTS=

# https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=

# auto
S3_REGION=

# blog-media
S3_BUCKET=

# Access Key ID of the token scoped to blog-media.
S3_ACCESS_KEY=

# Secret Access Key of that token.
S3_SECRET_KEY=

# https://media.<domain>
S3_PUBLIC_BASE_URL=
