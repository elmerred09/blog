# The local RustFS credentials, bucket, and region, in one place. compose.yaml
# passes this file to the rustfs and rustfs-init containers, and
# scripts/admin-keys.sh reads it to write the API's S3_* settings into .env.
# Local only, so not secret. Plain KEY=value lines: Docker and sh both read it.
RUSTFS_ACCESS_KEY=blog
RUSTFS_SECRET_KEY=blogsecret
S3_BUCKET=blog
S3_REGION=us-east-1
